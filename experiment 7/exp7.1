SET SERVEROUTPUT ON;

DECLARE
    v_count NUMBER := 0;

    CURSOR c_staff IS
        SELECT Name, Salary
        FROM Staff
        ORDER BY Salary DESC;

BEGIN
    FOR emp IN c_staff LOOP

        v_count := v_count + 1;

        DBMS_OUTPUT.PUT_LINE(
            v_count || '. ' || emp.Name ||
            ' - Salary: ' || emp.Salary
        );

        EXIT WHEN v_count = 5;

    END LOOP;
END;
/
