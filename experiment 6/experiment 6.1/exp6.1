-- VIEW FOR UNSOLD ITEMS (safe version using NOT EXISTS)
CREATE VIEW Unsold_Items AS
SELECT p.productname, p.category
FROM products p
WHERE NOT EXISTS (
    SELECT 1
    FROM order_details od
    WHERE od.productid = p.productid
);

SELECT * FROM Unsold_Items;

