-- SIMPLE VIEW
CREATE VIEW emp_view AS
SELECT emp_id, emp_name
FROM employees
WHERE emp_id = 101;

SELECT * FROM emp_view;


-- DELETE must be done on base table, not filtered view
DELETE FROM employees
WHERE emp_id = 105;


-- MATERIALIZED VIEW (correct syntax & names)
CREATE MATERIALIZED VIEW mv_emp AS
SELECT emp_id, emp_name
FROM employees
WITH NO DATA;

-- Populate the materialized view
REFRESH MATERIALIZED VIEW mv_emp;

SELECT * FROM mv_emp;
